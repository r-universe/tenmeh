[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "bones"]
	path = bones
	url = https://github.com/tenmeh/bones
[submodule "rewind"]
	path = rewind
	url = https://github.com/tenmeh/rewind
[submodule "whence"]
	path = whence
	url = https://github.com/tenmeh/whence
